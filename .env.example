# ===================================================
# This file is a TEMPLATE. Real secrets are managed
# by Doppler. Run `scripts/doppler-sync.sh` to
# generate the actual .env file.
# ===================================================

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=bite
MYSQL_USER=bite-dev
MYSQL_PASSWORD=CHANGE_ME

# DB (alias for MYSQL_PASSWORD)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bite
DB_USER=bite-dev
DB_PASSWORD=CHANGE_ME

# Runtime
ENVIRONMENT=prod

# JWT
JWT_SECRET_KEY=CHANGE_ME

# Resend (Email)
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Bite <noreply@bite-sized.xyz>

# Harvester
PROXY_URL=
HARVEST_INTERVAL=1h
DISCORD_WEBHOOK_URL=
LOG_LEVEL=info

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME
QDRANT_COLLECTION_NAME=bite-vectordb

# Recsys
RECSYS_BASE_URL=http://recsys-api:8001
RECSYS_API_KEY=CHANGE_ME

# Recommender batch
RDS_DATABASE=bite
RDS_HOST=mysql
RDS_USER=bite-dev
RDS_PASSWORD=CHANGE_ME
RDS_PORT=3306
QDRANT_ENDPOINT=http://qdrant:6333
QDRANT_API=CHANGE_ME

# App
APP_BASE_URL=https://api.bite-sized.xyz
APP_ENV=production
